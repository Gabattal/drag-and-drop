{
    "name": "drag-and-drop",
    "version": "1.0.0",
    "private": false,
    "description": "Drag and drop primitives for Luna Park",
    "keywords": [
        "luna-park",
        "plugin",
        "drag-and-drop",
        "dnd"
    ],
    "homepage": "https://luna-park.app",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gab-a/drag-and-drop.git"
    },
    "author": {
        "name": "gab-a"
    },
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/index.js"
        }
    },
    "module": "./dist/index.js",
    "files": [
        "dist/**"
    ],
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "prepublishOnly": "pnpm build",
        "test:dnd": "powershell.exe -ExecutionPolicy Bypass -File tests/dnd-harness/run-cdp-test.ps1",
        "preview": "luna-preview"
    },
    "dependencies": {
        "vue": "^3.5.32"
    },
    "devDependencies": {
        "@luna-park/eslint-config": "^1.2.6",
        "@luna-park/plugin": "^1.4.2",
        "@types/node": "^25.6.0",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.2.1",
        "globals": "^17.5.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.0",
        "vite": "^8.0.9",
        "vite-plugin-css-injected-by-js": "^5.0.1",
        "vue-tsc": "^3.2.7"
    },
    "peerDependencies": {
        "vue": "^3.5.24"
    }
}
